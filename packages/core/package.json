{
  "name": "@autono/open-pdf",
  "version": "0.1.0",
  "description": "Runtime and CLI for open-pdf — live real-PDF preview, click-to-comment inspector, and export to PDF or editable Word.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./locale": {
      "types": "./dist/locale/index.d.ts",
      "import": "./dist/locale/index.js"
    },
    "./env": {
      "types": "./env.d.ts"
    }
  },
  "bin": {
    "open-pdf": "./bin.js"
  },
  "files": [
    "bin.js",
    "dist",
    "env.d.ts",
    "src/app",
    "src/export",
    "src/locale",
    "src/shared",
    "skills",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test:e2e": "pnpm run build && playwright test",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "pdf",
    "documents",
    "react",
    "vite",
    "agents",
    "docx",
    "tailwind"
  ],
  "license": "MIT",
  "author": {
    "name": "autonoco",
    "url": "https://github.com/autonoco"
  },
  "homepage": "https://openpdf.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autonoco/open-pdf.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/autonoco/open-pdf/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/types": "^8.0.6",
    "@base-ui/react": "1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@takumi-rs/helpers": "2.14.0",
    "@vitejs/plugin-react": "^6.1.1",
    "chalk": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^15.0.0",
    "emoji-picker-react": "^4.22.2",
    "fast-glob": "^3.3.2",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.47.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "react-image-crop": "^11.1.2",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "takumi-pdf": "0.15.0",
    "tw-animate-css": "^1.4.0",
    "use-sync-external-store": "^1.7.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "~1.63.0",
    "@types/node": "^22.19.17",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsdown": "^0.9.9",
    "typescript": "^5.9.3"
  }
}
