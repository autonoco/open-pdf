{
  "name": "open-pdf-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:demo": "turbo run dev --filter=demo",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @autono/open-pdf test:e2e",
    "core": "pnpm --filter @autono/open-pdf",
    "cli": "pnpm --filter @autono/create-open-pdf"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "turbo": "^2.10.8",
    "vitest": "^2.1.9"
  }
}
